
---
import '../styles/global.css';

const playlists = [
  {
    number: '01',
    title: 'Do Your Ears Work',
    type: 'FEATURED PLAYLIST · OCTOBER 2026',
    description:
      'Eight songs, thirty-one minutes, and a personal perspective on hearing music differently.',
    href: '#featured',
  },
  {
    number: '02',
    title: 'Supporting Playlists',
    type: 'FROM THE MONTHLY ISSUE',
    description:
      'More listening discoveries from October, each with its own story and point of view.',
    href: '#supporting',
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4efe6" />
    <title>Playlists — The Listening Room</title>
    <meta
      name="description"
      content="Personal playlists and the stories behind the music at The Listening Room."
    />
  </head>
  <body>
    <header class="masthead">
      <a class="wordmark" href="/">The Listening Room<span class="period">.</span></a>
      <p class="masthead-note">AN INDEPENDENT MUSIC JOURNAL</p>
    </header>

    <nav class="navigation" aria-label="Main navigation">
      <a href="/">LATEST ISSUE</a>
      <a href="/archive/">THE ARCHIVE</a>
      <a href="/playlists/" aria-current="page">PLAYLISTS</a>
      <a href="/album-reviews/">ALBUM REVIEWS</a>
      <a href="/listener-requests/">LISTENER REQUESTS</a>
      <a href="/about/">ABOUT</a>
    </nav>

    <main class="category-page">
      <header class="category-heading">
        <p class="eyebrow">THE LISTENING ROOM · MUSIC &amp; DISCOVERY</p>
        <h1>Playlists<span class="period">.</span></h1>
        <p>
          Collections of music that make sense to me. Explore the selections
          and the feelings that keep bringing me back.
        </p>
      </header>

      <section class="playlist-list" aria-label="Playlist collection">
        {playlists.map((playlist) => (
          <article class="playlist-entry" id={playlist.number === '01' ? 'featured' : 'supporting'}>
            <p class="playlist-number">{playlist.number}</p>
            <div>
              <p class="eyebrow">{playlist.type}</p>
              <h2>{playlist.title}</h2>
              <p>{playlist.description}</p>
              <a class="text-link" href={playlist.href}>
                EXPLORE PLAYLIST <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </section>
    </main>

    <footer class="site-footer">
      <a class="wordmark" href="/">The Listening Room<span class="period">.</span></a>
      <p>MADE TO BE LISTENED TO.</p>
      <p>© 2026 THE LISTENING ROOM</p>
    </footer>
  </body>
</html>
