
---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4efe6" />
    <title>Listener Requests — The Listening Room</title>
    <meta
      name="description"
      content="Personal music reviews inspired by listener suggestions, published by The Listening Room."
    />
  </head>
  <body>
    <header class="masthead">
      <a class="wordmark" href="/" aria-label="The Listening Room home">
        The Listening Room<span class="period">.</span>
      </a>
      <p class="masthead-note">AN INDEPENDENT MUSIC JOURNAL</p>
    </header>

    <nav class="navigation" aria-label="Main navigation">
      <a href="/">LATEST ISSUE</a>
      <a href="/archive/">THE ARCHIVE</a>
      <a href="/playlists/">PLAYLISTS</a>
      <a href="/album-reviews/">ALBUM REVIEWS</a>
      <a href="/listener-requests/" aria-current="page">LISTENER REQUESTS</a>
      <a href="/about/">ABOUT</a>
    </nav>

    <main class="category-page">
      <header class="category-heading">
        <p class="eyebrow">THE LISTENING ROOM · READER-INSPIRED REVIEWS</p>
        <h1>Listener Requests<span class="period">.</span></h1>
        <p>
          Music brought to the room by listeners. Each selection is an
          opportunity to hear something from another perspective and discover
          what makes it worth returning to.
        </p>
      </header>

      <section class="playlist-list" aria-label="Listener request reviews">
        <article class="playlist-entry">
          <p class="playlist-number">01</p>
          <div>
            <p class="eyebrow">A CONTINUING COLUMN</p>
            <h2>Your suggestion. My perspective.</h2>
            <p>
              Reviews will appear here as selections are made and published.
              Each one will focus on the listening experience: what stands
              out, how the pieces come together, and why the music resonates.
            </p>
            <p class="placeholder-note">
              Requests are shared through Instagram. This is an editorial
              archive, not a submission form.
            </p>
          </div>
        </article>
      </section>
    </main>

    <footer class="site-footer">
      <a class="wordmark" href="/">The Listening Room<span class="period">.</span></a>
      <p>MADE TO BE LISTENED TO.</p>
      <p>© 2026 THE LISTENING ROOM</p>
    </footer>
  </body>
</html>
