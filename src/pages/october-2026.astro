      <p>MADE TO BE LISTENED TO.</p>
      <p>© 2026 THE LISTENING ROOM</p>
    </footer>

    <script>
      import { PageFlip } from 'page-flip';

      const bookElement = document.getElementById('flipbook');
      const previousButton = document.getElementById('previous-page');
      const nextButton = document.getElementById('next-page');
      const pageStatus = document.getElementById('page-status');

      if (bookElement && previousButton && nextButton && pageStatus) {
        const pageFlip = new PageFlip(bookElement, {
          width: 600,
          height: 760,
          size: 'stretch',
          minWidth: 280,
          maxWidth: 1200,
          minHeight: 360,
          maxHeight: 900,
          showCover: true,
          usePortrait: true,
          startPage: 0,
          drawShadow: true,
          flippingTime: 1100,
          maxShadowOpacity: 0.12,
          mobileScrollSupport: true,
          autoSize: true
        });

        pageFlip.loadFromHTML(bookElement.querySelectorAll('.flip-page'));

        function updateControls() {
          const current = pageFlip.getCurrentPageIndex();
          const total = pageFlip.getPageCount();

          previousButton.disabled = current <= 0;
          nextButton.disabled = current >= total - 1;

          pageStatus.textContent = current === 0
            ? 'COVER'
            : `PAGE ${current} OF ${total - 1}`;

          nextButton.textContent = current >= total - 1
            ? 'END OF ISSUE'
            : 'TURN PAGE →';
        }

        pageFlip.on('flip', updateControls);

        document.querySelectorAll('.contents-list a[data-page]').forEach((link) => {
          link.addEventListener('click', (event) => {
            event.preventDefault();
            const targetPage = Number(link.dataset.page);

            if (
              Number.isInteger(targetPage) &&
              targetPage >= 0 &&
              targetPage < pageFlip.getPageCount()
            ) {
              pageFlip.turnToPage(targetPage);
            }
          });
        });

        previousButton.addEventListener('click', () => pageFlip.flipPrev());
        nextButton.addEventListener('click', () => pageFlip.flipNext());

        updateControls();
      }
    </script>
  </body>
</html>
