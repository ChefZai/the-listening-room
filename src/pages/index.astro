
---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4efe6" />
    <meta
      name="description"
      content="The Listening Room — a personal music magazine about the music that stays with us."
    />
    <title>The Listening Room — A Music Magazine</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="masthead">
      <a class="wordmark" href="/" aria-label="The Listening Room home">
        The Listening Room<span class="period">.</span>
      </a>
      <p class="masthead-note">AN INDEPENDENT MUSIC JOURNAL</p>
    </header>

   
    <nav class="navigation" aria-label="Main navigation">
      <a href="/">LATEST ISSUE</a>
      <a href="/archive/">THE ARCHIVE</a>
      <a href="/playlists/">PLAYLISTS</a>
      <a href="/album-reviews/">ALBUM REVIEWS</a>
      <a href="/listener-requests/">LISTENER REQUESTS</a>
      <a href="/about/">ABOUT</a>
    </nav>


    <main>
      <section class="issue-intro" id="latest">
        <div>
          <p class="eyebrow">THE LISTENING ROOM · OCTOBER 2026</p>
          <h1>Music is<br />a way of <em>seeing.</em></h1>
          <p class="intro-copy">
            A personal music magazine exploring the songs, albums, and
            unexpected connections that keep bringing us back.
          </p>
          <a class="text-link" href="#featured">
		  	<a class="text-link" href="/october-2026/">ENTER THE LATEST ISSUE <span aria-hidden="true">↗</span></a>
          </a>
        </div>

        <div class="cover-art" aria-label="October issue cover artwork">
          <div class="cover-top">
            <span>ISSUE NO. 01</span>
            <span>OCTOBER 2026</span>
          </div>
          <div class="cover-center">
            <p class="cover-kicker">A QUESTION OF TASTE</p>
            <p class="cover-title">DO YOUR<br />EARS WORK?</p>
            <p class="cover-subtitle">A PLAYLIST BY ISAIAH WILKINS</p>
          </div>
          <div class="cover-bottom">
            <span>LISTEN CLOSER.</span>
            <span>VOL. 01</span>
          </div>
        </div>
      </section>

      
      <section class="whats-new" id="whats-new">
        <div class="section-heading">
          <p class="eyebrow">THE LATEST</p>
          <span>FRESH FROM THE LISTENING ROOM</span>
        </div>

        <h2>What's New</h2>
        <p class="section-copy">
          New listening notes, reviews, and stories from the magazine.
        </p>

        <div class="feature-links">
          <a href="/playlists/">
            <span>01</span>
            <span>Playlists &amp; listening stories</span>
            <span aria-hidden="true">↗</span>
          </a>
          <a href="/album-reviews/">
            <span>02</span>
            <span>Latest album review</span>
            <span aria-hidden="true">↗</span>
          </a>
          <a href="/listener-requests/">
            <span>03</span>
            <span>Latest Listener Request</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>

    </main>

    <footer class="site-footer">
      <a class="wordmark" href="/">The Listening Room<span class="period">.</span></a>
      <p>MADE TO BE LISTENED TO.</p>
      <p>© 2026 THE LISTENING ROOM</p>
    </footer>
  </body>
</html>
